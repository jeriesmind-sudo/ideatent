{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ideatent-weekly-automation",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "https://my.ideatent.workers.dev"
  },
  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
